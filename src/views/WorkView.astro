---
import Intro from "../components/Intro.astro";
import Media from "../components/Media.astro";
import { WORK } from "../data/copy";
import { t, type Lang } from "../lib/i18n";

export interface WorkThumb {
  src: string;
  href: string;
  name: string;
  key: string;
}

interface Props {
  lang: Lang;
  prev: { href: string; label: string };
  next: { href: string; label: string };
  thumbs: WorkThumb[];
}
const { lang, prev, next, thumbs } = Astro.props;
---

<Intro text={t(WORK.intro, lang)} prev={prev} next={next} />

<section
  class="relative flex min-h-[calc(100svh-var(--intro)-var(--fs)*3)] items-center justify-center px-[10px] py-[calc(var(--fs)*3)]"
  data-work
>
  <ul class="grid w-full grid-cols-2 gap-[10px] md:flex md:w-auto md:justify-center">
    {
      thumbs.map((th, i) => (
        <li class="md:w-[15vw]" data-work-item={th.key} data-work-src={th.src}>
          <a href={th.href} class="block" aria-label={th.name}>
            <Media src={th.src} alt={th.name} aspect="3 / 2" imgClass="work-img" eager={i < 4} />
            <span class="mt-[0.4em] block text-muted md:hidden">{th.name}</span>
          </a>
        </li>
      ))
    }
  </ul>

  <!-- WebGL redraw of the thumbnails (src/scripts/work-gl.ts). -->
  <canvas class="pointer-events-none absolute inset-0 hidden h-full w-full" data-work-gl aria-hidden="true"></canvas>

</section>

<style>
  /* With WebGL running, the canvas draws the pictures; the DOM ones stay for
     layout, links and hit-testing. */
  [data-work][data-gl] :global(.work-img) {
    opacity: 0;
  }
  [data-work][data-gl] [data-work-gl] {
    display: block;
  }
  :global(.work-img) {
    filter: grayscale(1);
    transition: filter 0.6s var(--ease-out);
  }
  @media (hover: hover) {
    [data-work-item]:hover :global(.work-img) {
      filter: grayscale(0);
    }
  }
</style>
