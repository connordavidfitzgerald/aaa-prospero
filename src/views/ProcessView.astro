---
import Intro from "../components/Intro.astro";
import { APPROACH } from "../data/copy";
import { t, type Lang } from "../lib/i18n";

interface Props {
  lang: Lang;
  prev: { href: string; label: string };
  next: { href: string; label: string };
}
const { lang, prev, next } = Astro.props;
---

<Intro text={t(APPROACH.intro, lang)} prev={prev} next={next} />

<section class="grid-12 mt-[28svh] pb-[20svh]">
  <div class="col-span-4 md:col-start-7 md:col-span-6">
    <p data-split>{t(APPROACH.lead, lang)}</p>
    <ol class="mt-[calc(var(--fs)*2)]">
      {
        APPROACH.steps.map((s, i) => (
          <li class="rule flex py-[0.55em]" data-rule>
            <span class="w-[2.2em] shrink-0 text-muted tabular" data-reveal>{String(i + 1).padStart(2, "0")}</span>
            <span data-reveal>{t(s, lang)}</span>
          </li>
        ))
      }
    </ol>
  </div>
</section>
