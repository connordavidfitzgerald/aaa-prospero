---
import Intro from "../components/Intro.astro";
import { CONTACT } from "../data/copy";
import { t, type Lang } from "../lib/i18n";

interface Props {
  lang: Lang;
  prev: { href: string; label: string };
  next: { href: string; label: string };
}
const { lang, prev, next } = Astro.props;
---

<Intro text={t(CONTACT.intro, lang)} prev={prev} next={next} />

<section class="grid-12 mt-[30svh] pb-[10svh]">
  <dl class="col-span-4 md:col-start-7 md:col-span-6">
    <div class="rule flex py-[0.55em]" data-rule>
      <dt class="w-[var(--num)] shrink-0 text-muted" data-reveal>{t(CONTACT.person, lang)}</dt>
      <dd data-reveal>{CONTACT.name}</dd>
    </div>
    <div class="rule flex py-[0.55em]" data-rule>
      <dt class="w-[var(--num)] shrink-0 text-muted" data-reveal>{t(CONTACT.emailLabel, lang)}</dt>
      <dd data-reveal><a href={`mailto:${CONTACT.email}`} class="link break-all">{CONTACT.email}</a></dd>
    </div>
  </dl>
  <p class="col-span-4 mt-[calc(var(--fs)*4)] md:col-start-7 md:col-span-6" data-split>{t(CONTACT.signoff, lang)}</p>
</section>
